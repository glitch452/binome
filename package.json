{
  "name": "binome",
  "version": "0.0.0",
  "description": "An AI Generated Countdown timer app",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/glitch452/binome.git"
  },
  "author": "David Dearden",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/glitch452/binome/issues"
  },
  "homepage": "https://github.com/glitch452/binome#readme",
  "scripts": {
    "prebuild": "tsx scripts/generate-build-info.ts",
    "build": "next build && serwist build serwist.config.mjs && node scripts/copy-sw-to-out.mjs",
    "predev": "tsx scripts/generate-build-info.ts",
    "clean": "rimraf .next out",
    "dev": "next dev",
    "format:check": "npm run format:ci",
    "format:ci": "prettier --check '**.{css,html,mjs,cjs,js,json,jsx,cjsx,mjsx,md,mdx,scss,cts,ts,tsx,ctsx,mtsx,yaml,yml}'",
    "format": "prettier --write .",
    "lint:ci": "eslint . --max-warnings 0",
    "lint:inspect": "npx @eslint/config-inspector",
    "lint:nc": "eslint . --max-warnings 0 --report-unused-disable-directives --fix",
    "lint": "eslint . --max-warnings 0 --cache --report-unused-disable-directives --fix",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "start": "npx serve out --listen 3000",
    "test:ci": "vitest run --config vite.config.ci.ts --coverage",
    "test:snap": "vitest run --coverage --update",
    "test:w": "vitest",
    "test": "vitest run",
    "type": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@hookform/resolvers": "5.4.0",
    "@serwist/next": "9.5.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.18.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.79.0",
    "serwist": "9.5.11",
    "shadcn": "4.11.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@serwist/cli": "9.5.11",
    "@tailwindcss/postcss": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.9",
    "autoprefixer": "10.5.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "9.39.4",
    "eslint-config-spartan": "7.0.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.7",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.5",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
