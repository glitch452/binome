{
  // Docs: https://docs.renovatebot.com/configuration-options

  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>glitch452/renovate-config', 'github>glitch452/renovate-config//presets/npm'],

  // Run on Friday Mornings
  schedule: ['* 0-6 * * 5'],

  packageRules: [
    {
      description: 'Put typescript into its own group',
      groupName: 'Typescript',
      groupSlug: 'typescript',
      matchPackageNames: ['typescript'],
    },
    {
      description: 'Separate @vitejs/plugin-react until its installation issues are resolved',
      groupName: 'ViteJS plugin-react',
      groupSlug: 'vitejs-plugin-react',
      matchPackageNames: ['@vitejs/plugin-react'],
    },
  ],
}
